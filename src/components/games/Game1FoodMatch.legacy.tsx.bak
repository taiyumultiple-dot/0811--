// Lukang Delicacies Game Topics
interface SurvivalQuestion {
  id: string;
  category: number;
  categoryName: string;
  name: string;
  prompt: string;
  speakText?: string;
  correctAnswers: string[];
  incorrectAnswers: string[];
  sequence?: string[];
  tip: string;
}

// 一局遊戲的限時秒數（時間到即結算分數）
