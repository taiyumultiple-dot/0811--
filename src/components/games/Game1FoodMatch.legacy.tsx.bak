// For "聽音選漢字" questions (category 1), the player hears/sees the Mandarin word
// as the task, and must pick out the correct Taiwanese Hokkien term (with Tai-lo
// pronunciation shown) among the falling options. Other categories keep their
// original Tai-lo based behaviour since they teach romanization directly.
const getMandarinFor = (hokkienText: string): string => LUKANG_DATA_MAP[hokkienText]?.mandarin || hokkienText;

