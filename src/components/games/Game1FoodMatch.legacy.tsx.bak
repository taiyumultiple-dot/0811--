function sampleQuestions(): SurvivalQuestion[] {
  // 60 秒限時模式：從題庫中隨機抽取 50 題（若題庫超過 50 題，只取其中 50 題；
  // 目前題庫剛好 50 題，等於隨機打亂全部題目的出題順序）。
  const shuffle = <T,>(arr: T[]): T[] => [...arr].sort(() => Math.random() - 0.5);
  return shuffle(SURVIVAL_QUESTION_POOL).slice(0, 50);
}

